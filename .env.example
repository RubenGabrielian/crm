NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Resend: sends the login / registration code emails
RESEND_API_KEY=re_...
RESEND_FROM=onboarding@resend.dev

# Public address of the app, used for the sign-in link in employee invites.
# Without it the link uses the address the owner has open.
SITE_URL=https://your-domain.am

# Supabase secret key (Project Settings > API keys > Secret keys). Server only.
SUPABASE_SECRET_KEY=sb_secret_...
